# RoboTwin 2.0 simulator environment: runs the evaluation CLIENT only.
#
# STRICT: follows the official upstream README, "Evaluation on RoboTwin-2.0 >
# Preparing the Environment", steps 1-5, verbatim and in order. The package
# list is the README's patched script/requirements.txt exactly as printed --
# nothing added, nothing dropped, nothing reordered.
#
#     docker build -f docker/Dockerfile.robotwin -t lingbotva-rmbench-robotwin:latest docker/
#
# The model server runs in the lingbotva-rmbench image; the two containers talk
# over the host network (server and client must share a machine, per the README).
#
# Step 6 (`bash script/_download_assets.sh`) is left to run time: the assets are
# multi-GB and belong next to the mounted RoboTwin checkout, not in the image.
#
# SAPIEN renders through Vulkan headlessly. That works in docker only when the
# NVIDIA runtime injects the graphics stack:
#     docker run --gpus all -e NVIDIA_DRIVER_CAPABILITIES=all ...
# (nvidia-container-toolkit then provides the vulkan ICD; `vulkaninfo --summary`
# should list your GPU inside the container before you debug SAPIEN itself.)

FROM nvidia/cuda:12.6.3-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1

# Base interpreter + toolchain. The README assumes a host that already has these.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 python3.10-dev python3-pip python-is-python3 \
        git ca-certificates build-essential ninja-build \
        libgl1 libglib2.0-0 libx11-6 libxext6 \
    && rm -rf /var/lib/apt/lists/*

# --- Step 1: Vulkan dependencies (README, verbatim) -------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        libvulkan1 mesa-vulkan-drivers vulkan-tools \
    && rm -rf /var/lib/apt/lists/*

# pytorch3d builds against torch, so the sim env carries the same cu126 torch
# the model env uses.
RUN pip install torch==2.9.0 torchvision==0.24.0 torchaudio==2.9.0 \
        --index-url https://download.pytorch.org/whl/cu126

# --- Step 3: the patched script/requirements.txt (README, verbatim) ---------
# `ffmpeg` below is the PyPI package the README lists, not the apt one.
RUN pip install \
        transforms3d==0.4.2 \
        sapien==3.0.0b1 \
        scipy==1.10.1 \
        mplib==0.2.1 \
        gymnasium==0.29.1 \
        trimesh==4.4.3 \
        open3d==0.18.0 \
        imageio==2.34.2 \
        pydantic \
        zarr \
        openai \
        huggingface_hub==0.36.2 \
        h5py \
        azure==4.0.0 \
        azure-ai-inference \
        "pyglet<2" \
        wandb \
        moviepy \
        imageio \
        termcolor \
        av \
        matplotlib \
        ffmpeg

# --- Steps 4 + 5: the patched line 8 of script/_install.sh (README, verbatim) -
ARG MAX_JOBS=8
ENV MAX_JOBS=${MAX_JOBS}
RUN pip install "git+https://github.com/facebookresearch/pytorch3d.git@stable" \
        --no-build-isolation

WORKDIR /workspace/lingbot-va
CMD ["/bin/bash"]
